# ==============================================================================
# Multi-Stage Production Frontend Builder & Lightweight Nginx Runners
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm

# Copy repository dependency manifests & source code
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

# Install exact dependencies
RUN pnpm install --frozen-lockfile

# Compile and optimize all production frontend bundles
RUN pnpm build

# Base Nginx runtime with custom SPA routing configuration
FROM nginx:1.27-alpine AS runner
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf

# ------------------------------------------------------------------------------
# Target 1: Storefront Container (Customer Portal)
# ------------------------------------------------------------------------------
FROM runner AS store-app
COPY --from=builder /app/apps/store/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 2: Web Admin Container (Enterprise Multi-Tenant Console)
# ------------------------------------------------------------------------------
FROM runner AS admin-app
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 3: POS Cashier Container (Supermarket & Retail Register)
# ------------------------------------------------------------------------------
FROM runner AS pos-app
COPY --from=builder /app/apps/cashier/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 4: Delivery Courier Container (Fleet & GPS Dispatch)
# ------------------------------------------------------------------------------
FROM runner AS delivery-app
COPY --from=builder /app/apps/delivery/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 5: HR Console Container (Staff Directory & Payroll)
# ------------------------------------------------------------------------------
FROM runner AS hr-app
COPY --from=builder /app/apps/hr/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 6: CEO Command Center Container (Executive BI Dashboard)
# ------------------------------------------------------------------------------
FROM runner AS ceo-app
COPY --from=builder /app/apps/ceo/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
