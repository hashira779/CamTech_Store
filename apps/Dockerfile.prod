# syntax=docker/dockerfile:1
# ==============================================================================
# Multi-Stage Production Frontend Builder & Lightweight Nginx Runners
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate

# ── Layer 1: dependency manifests only (cached unless lockfile changes) ──
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json         ./packages/ui/
COPY apps/web/package.json            ./apps/web/
COPY apps/store/package.json          ./apps/store/
COPY apps/cashier/package.json        ./apps/cashier/
COPY apps/delivery/package.json       ./apps/delivery/
COPY apps/hr/package.json             ./apps/hr/
COPY apps/ceo/package.json            ./apps/ceo/

# ── Layer 2: install deps (BuildKit cache mount reuses pnpm store across builds) ──
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ── Layer 3: source code (changes often, but install layer stays cached) ──
COPY turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

ARG VITE_SUPABASE_URL=https://ypfztbwdvkfdupsniixw.supabase.co
ARG VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlwZnp0YndkdmtmZHVwc25paXh3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1MjY1MDgsImV4cCI6MjEwNDEwMjUwOH0.0xU0S2_S45a9xHjHR6fdSJwRuHdc1w6i3Pm7Ahq8pQ0
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Compile and optimize all production frontend bundles with controlled concurrency to protect host RAM
ENV NODE_OPTIONS="--max-old-space-size=1536"
RUN pnpm turbo run build --concurrency=1

# Base Nginx runtime with custom SPA routing configuration
FROM nginx:1.27-alpine AS runner
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf

# ------------------------------------------------------------------------------
# Target 1: Storefront Container (Customer Portal)
# ------------------------------------------------------------------------------
FROM runner AS store-app
COPY --from=builder /app/apps/store/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 2: Web Admin Container (Enterprise Multi-Tenant Console)
# ------------------------------------------------------------------------------
FROM runner AS admin-app
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 3: POS Cashier Container (Supermarket & Retail Register)
# ------------------------------------------------------------------------------
FROM runner AS pos-app
COPY --from=builder /app/apps/cashier/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 4: Delivery Courier Container (Fleet & GPS Dispatch)
# ------------------------------------------------------------------------------
FROM runner AS delivery-app
COPY --from=builder /app/apps/delivery/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 5: HR Console Container (Staff Directory & Payroll)
# ------------------------------------------------------------------------------
FROM runner AS hr-app
COPY --from=builder /app/apps/hr/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 6: CEO Command Center Container (Executive BI Dashboard)
# ------------------------------------------------------------------------------
FROM runner AS ceo-app
COPY --from=builder /app/apps/ceo/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ------------------------------------------------------------------------------
# Target 7: Infra & Security Control Center Container (NOC/SOC Dashboard)
# Separate container from admin-app — dedicated port 5009 on host.
# Same web SPA dist; subdomain detection (infra.*) renders InfraControlApp.
# ------------------------------------------------------------------------------
FROM runner AS infra-app
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
