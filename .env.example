# ---------------------------------------------------------------------------
# MyStore Platform — environment template
# Copy to services/backend/.env and apps/web/.env.local as needed.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# PostgreSQL (run `docker compose up -d` to start)
DATABASE_URL="postgresql://mystore:mystore_dev@localhost:5432/mystore?schema=public"

# Redis (cache, rate limiting, idempotency, queues)
REDIS_URL="redis://localhost:6379"

# Auth — CHANGE THIS in any real environment
JWT_SECRET="dev-only-change-me-please-use-a-long-random-string"
JWT_EXPIRES_IN="1h"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Web -------------------------------------------------------------------
# Base URL the browser uses to reach the backend API
NEXT_PUBLIC_API_URL="http://localhost:4000"
